// Next.js 主后端的数据层（SQLite）。课程目录用 raw(JSON 文本)整存，避免字段漂移；
// 进度/笔记/状态等是我们自有的结构化数据。DB 文件落在 ~/.youdao_course/app.db。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- 目录（从 Python 网关同步而来，之后从 DB 读，不再每次打有道）----
model Course {
  productId Int      @id
  name      String
  raw       String // 整条 course JSON（authors/cardType 等都在里面）
  syncedAt  DateTime @default(now())
  videos    Video[]
}

model Video {
  // 同一讲（videoId）可被多门课（productId）打包售卖，故 videoId 不是全局唯一；
  // 主键用 (productId, videoId) 复合，避免「该讲已属另一门课」时 create 撞唯一约束。
  videoId   Int
  productId Int
  title     String?
  idx       Int      @default(0) // 在课程内的顺序
  raw       String // 整条 video JSON（clarity/contentId/cardPackageId/duration/locked…）
  syncedAt  DateTime @default(now())
  course    Course   @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([productId, videoId])
  @@index([productId])
}

// ---- 自有结构化状态 ----
model Progress {
  // 同一讲（videoId）可被多门课（productId）打包售卖，故 videoId 不是全局唯一；
  // 主键用 (productId, videoId) 复合，否则两门课共享同一 videoId 时后写者会在 DB 层覆盖前者（丢进度）。
  videoId    Int
  productId  Int
  t          Float    @default(0) // 已看到（秒）
  d          Float    @default(0) // 时长（秒）
  title      String?
  courseName String?
  at         DateTime @updatedAt

  @@id([productId, videoId])
}

model Note {
  id          String   @id
  videoId     Int
  // 课程身份在创建时落库:videoId 跨课不唯一，靠 productId 绑对课;courseName/lessonTitle
  // 是创建时的快照，目录被清/讲次下架时仍能显示与归类（读路径实时目录优先、它们兜底）。
  productId   Int?
  courseName  String?
  lessonTitle String?
  t           Int      @default(0) // 时间戳（秒）
  text        String
  strokes     String? // 矢量批注 JSON（归一化坐标的 Stroke[]）；普通文字笔记为 null
  at          DateTime @default(now())

  @@index([videoId])
  @@index([productId, videoId])
}

// ---- 内置 Claude 助教（按讲对话）----
// ChatMessage 是 UI 渲染的真相源；模型上下文续接靠 ChatThread.sessionId（Agent SDK resume）。
model ChatMessage {
  id        String   @id
  videoId   Int
  productId Int? // 课程归属标记（写入时记录）；不改 videoId 键与对话逻辑
  role      String // "user" | "assistant"
  text      String
  image     String? // 附图文件 id（用户消息可带批注画面，落盘在 chat-imgs/）
  videoT    Int? // 提问时的播放位置(秒)；存问答为笔记时作截图/跳转的时间锚点
  at        DateTime @default(now())

  @@index([videoId])
}

model ChatThread {
  videoId   Int      @id
  productId Int? // 课程归属标记（写入时记录）；键仍为 videoId，resume 逻辑不变
  sessionId String? // Claude Agent SDK 会话 id，用于多轮 resume
  updatedAt DateTime @updatedAt
}

// 网关缓存/缓冲状态的镜像（真相在网关，这里供 UI 直读 + 跨设备）
model CacheStatus {
  videoId        Int      @id
  cachedSegments Int      @default(0)
  totalSegments  Int?
  state          String? // queued/working/done/error
  bytes          Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model ThumbStatus {
  videoId   Int      @id
  state     String // gen/ready/error
  url       String?
  number    Int?
  column    Int?
  width     Int?
  height    Int?
  updatedAt DateTime @updatedAt
}

// 偏好（rate/density）、last-watched 等：key -> JSON 文本
model Setting {
  key   String @id
  value String
}

model SyncMeta {
  key   String   @id
  value String?
  at    DateTime @updatedAt
}
