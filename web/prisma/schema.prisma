// Next.js 主后端的数据层（SQLite）。课程目录用 raw(JSON 文本)整存，避免字段漂移；
// 进度/笔记/状态等是我们自有的结构化数据。DB 文件落在 ~/.youdao_course/app.db。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- 目录（从 Python 网关同步而来，之后从 DB 读，不再每次打有道）----
model Course {
  productId Int      @id
  name      String
  raw       String // 整条 course JSON（authors/cardType 等都在里面）
  syncedAt  DateTime @default(now())
  videos    Video[]
}

model Video {
  // 同一讲（videoId）可被多门课（productId）打包售卖，故 videoId 不是全局唯一；
  // 主键用 (productId, videoId) 复合，避免「该讲已属另一门课」时 create 撞唯一约束。
  videoId   Int
  productId Int
  title     String?
  idx       Int      @default(0) // 在课程内的顺序
  raw       String // 整条 video JSON（clarity/contentId/cardPackageId/duration/locked…）
  syncedAt  DateTime @default(now())
  course    Course   @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([productId, videoId])
  @@index([productId])
}

// ---- 自有结构化状态 ----
model Progress {
  // 同一讲（videoId）可被多门课（productId）打包售卖，故 videoId 不是全局唯一；
  // 主键用 (productId, videoId) 复合，否则两门课共享同一 videoId 时后写者会在 DB 层覆盖前者（丢进度）。
  videoId    Int
  productId  Int
  t          Float    @default(0) // 已看到（秒）
  d          Float    @default(0) // 时长（秒）
  title      String?
  courseName String?
  at         DateTime @updatedAt

  @@id([productId, videoId])
}

model Note {
  id          String   @id
  videoId     Int
  // 课程身份在创建时落库:videoId 跨课不唯一，靠 productId 绑对课;courseName/lessonTitle
  // 是创建时的快照，目录被清/讲次下架时仍能显示与归类（读路径实时目录优先、它们兜底）。
  productId   Int?
  courseName  String?
  lessonTitle String?
  t           Int      @default(0) // 时间戳（秒）
  text        String
  strokes     String? // 矢量批注 JSON（归一化坐标的 Stroke[]）；普通文字笔记为 null
  at          DateTime @default(now())

  @@index([videoId])
  @@index([productId, videoId])
}

// ---- 内置 Claude 助教（多聊天 + 后台并行）----
// 一讲可有多个 chat；也可以是 independent（不绑任何讲）。每个 chat 自带 sessionId 用于
// Claude Agent SDK 续上下文。ChatMessage 是 UI 渲染真相源，FK 到 Chat（级联删）。
model Chat {
  id        String        @id // 新建用 nanoid；迁移用 "legacy-{pid}-{vid}"
  kind      String // "lesson" | "independent"
  productId Int? // 仅 lesson 有值；independent 必为 null
  videoId   Int? // 同上
  title     String? // null=「新对话」；首条用户消息后服务端 trim 截 40 字写入
  sessionId String? // Agent SDK resume token；abort 时不更新（保持上次成功值，下次能续上）
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([productId, videoId, updatedAt])
  @@index([kind, updatedAt])
}

model ChatMessage {
  id        String   @id
  chatId    String // FK 到 Chat.id（级联删消息）
  // 语义：发送时所看的讲（供 videoT 跳回 / 存为笔记时锚定）。可空：独立聊天无播放器
  // 上下文时写 NULL；非空也允许指向 chat 自己绑定之外的讲（chat 跨讲被复用时）。
  videoId   Int?
  productId Int?
  role      String // "user" | "assistant"
  text      String
  image     String? // 附图文件 id（用户消息可带批注画面，落盘在 chat-imgs/）
  videoT    Int? // 提问时的播放位置(秒)
  at        DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, at])
  @@index([productId, videoId]) // 保留：笔记/批注/跨聊天反查（按讲找消息）时用
}

// 网关缓存/缓冲状态的镜像（真相在网关，这里供 UI 直读 + 跨设备）
model CacheStatus {
  videoId        Int      @id
  cachedSegments Int      @default(0)
  totalSegments  Int?
  state          String? // queued/working/done/error
  bytes          Int      @default(0)
  updatedAt      DateTime @updatedAt
}

model ThumbStatus {
  videoId   Int      @id
  state     String // gen/ready/error
  url       String?
  number    Int?
  column    Int?
  width     Int?
  height    Int?
  updatedAt DateTime @updatedAt
}

// 偏好（rate/density）、last-watched 等：key -> JSON 文本
model Setting {
  key   String @id
  value String
}

model SyncMeta {
  key   String   @id
  value String?
  at    DateTime @updatedAt
}

// 增量同步游标(单例)。区别于 SyncMeta(value 可空、历史目录同步用):此处 value 非空,
// 专存网关事件日志拉取的 lastSeq。单例 key='taskEventSeq'(存 int 字符串,初值 '0')。
model SyncState {
  key   String   @id
  value String
  at    DateTime @updatedAt
}

// 任务历史:网关在每个真实终态转换点 append 带 (epoch, seq) 的事件,web 按 seq>上次拉增量写入。
// 设置页"全部"标签从这里倒序读;cap 后端 500 条够看。
// 幂等由主键 id='evt-<epoch>-<seq>' 担保(#3):每 boot epoch +1,跨重启复用的 seq 在新 epoch
// 下是另一行 id。seq 列保留作 epoch 内序号(展示/排序参考),但【不再 @unique】——加 epoch 后
// seq 跨 boot 会复用,旧的 seq @unique 会让第二个 boot 的同 seq 行插入抛 P2002→整批 ingest 回滚
// →静默丢真终态(正是 #3 要修的 bug)。存量随机-id 行 / full→done 回填行 seq=NULL。
model TaskHistory {
  id        String   @id
  kind      String // "buffer" | "thumb" | "prefetch"
  videoId   Int
  productId Int? // 共享讲(同 videoId 跨课)归属:按 (productId,videoId) 取课程名(#15);NULL=未知/存量
  state     String // "done"|"error"|"cancelled"|"paused"(运行态 queued/working 不再入库)
  reason    String? // error 时填失败原因(最多 200 字)
  at        DateTime @default(now())
  seq       Int? // 网关事件 epoch 内序号(非全局唯一,幂等靠 id 主键);NULL=存量/回填行

  @@index([at])
  @@index([videoId, kind, at])
}

