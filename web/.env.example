# 复制为 .env（Prisma 读取 .env，不读 .env.local）
# SQLite 数据库文件路径（建议与其它持久化数据同目录）
DATABASE_URL="file:/Users/<you>/.youdao_course/app.db"
# Python 有道网关地址（仅 localhost；可省略，默认 http://127.0.0.1:8808）
GATEWAY_ORIGIN="http://127.0.0.1:8808"

# 内置 Claude 助教用「Claude 订阅」驱动（Claude Agent SDK），不需要 API key。
# 重要：别设 ANTHROPIC_API_KEY —— 设了它会优先于订阅。本机已 `claude` 登录即可。
# 无头/重启场景可用一年期订阅 token（仅本机；放 .env.local）：
#   运行 `claude setup-token` 生成，然后：
# CLAUDE_CODE_OAUTH_TOKEN="..."
